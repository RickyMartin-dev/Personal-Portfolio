# Bedrock-compatible local inference settings.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
MAX_OUTPUT_TOKENS=300
GUARDRAIL_BLOCK_THRESHOLD=0.5
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://rickymartin-dev.github.io

# Choose one local credential source:
# 1. Set AWS_BEARER_TOKEN_BEDROCK to a Bedrock API key that allows InvokeModel
#    and InvokeGuardrailChecks; or
# 2. Uncomment AWS_PROFILE and use a configured AWS CLI profile / SSO session.
AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=default
