#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./scripts/project start [--task "request"] [--json]
  ./scripts/project finish [--summary "outcome"] [--json] [--friction "area|symptom|cause|fix"]...
  ./scripts/project archive-snapshot --summary "outcome" [--agent codex|claude]
  ./scripts/project check
  ./scripts/project check --json
  ./scripts/project doctor [--json]
  ./scripts/project release-check
  ./scripts/project context
  ./scripts/project plan <slug> [title]
  ./scripts/project experiment <slug> [title]
  ./scripts/project compact <slug> [title]
  ./scripts/project research <slug> [question]
  ./scripts/project upgrade <slug> [title]
  ./scripts/project specialist <slug> [title]
  ./scripts/project suggest-upgrades [--json]
  ./scripts/project friction "<area>" "<symptom>" "<cause>" "<fix>" [--status open|fixed|lesson]
  ./scripts/project learn [--json]
  ./scripts/project retro [YYYY-MM] [--html] [--json] [--force]

Commands:
  start    Automatically orient the active agent and refresh local context.
  finish   Automatically verify work and capture a durable handoff.
  archive-snapshot  Save a concise snapshot to PROJECT_SNAPSHOT_ARCHIVE_ROOT when configured.
  check    Validate the portable starter contract.
  doctor   Validate the starter, with optional machine-readable output.
  release-check  Run all checks required before a release or push.
  context  Print the recommended orientation order.
  plan     Create a plan under docs/plans/active/ from the shared template.
  compact  Capture a compaction-safe project snapshot under docs/compactions/.
  research Create a dated research brief under docs/research/.
  upgrade  Create a bounded upgrade proposal under docs/upgrades/proposals/.
  specialist Create a reviewed specialist role brief under agents/specialists/.
  suggest-upgrades Print deterministic, evidence-oriented next improvements.
  friction Append a sanitized entry to docs/state/friction.md.
  learn    Group friction by area and draft proposals for repeated problems.
  retro    Write a monthly retrospective under docs/retrospectives/ (--html adds a .lavish page).
EOF
}

valid_slug() {
  [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

render_template() {
  local template="$1"
  local target="$2"
  local slug="$3"
  local title="$4"
  local today
  today="$(date +%F)"
  while IFS= read -r line; do
    case "$line" in
      '# Plan: <title>'|'# Experiment: <title>'|'# Research report: <question>'|'# Upgrade proposal: <title>'|'# Specialist role: <title>')
        line="${line/<title>/$title}"
        line="${line/<question>/$title}"
        printf '%s\n' "$line"
        ;;
      *'<YYYY-MM-DD>'*)
        printf '%s\n' "${line//<YYYY-MM-DD>/$today}"
        ;;
      *'<slug>'*)
        printf '%s\n' "${line//<slug>/$slug}"
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done < "$template" > "$target"
}

append_snapshot_doc() {
  local heading="$1"
  local path="$2"
  printf '\n## %s\n\n' "$heading"
  if [[ -f "$path" ]]; then
    cat "$path"
  else
    printf '_Missing at snapshot time: `%s`_\n' "$path"
  fi
  printf '\n'
}

compact_snapshot() {
  local slug="$1"
  local title="$2"
  local stamp target
  stamp="$(date +%Y-%m-%d-%H%M)"
  target="$ROOT_DIR/docs/compactions/${stamp}-${slug}.md"
  if [[ -e "$target" ]]; then
    printf 'compaction already exists: %s\n' "$target" >&2
    exit 1
  fi
  {
    printf '# Compaction snapshot: %s\n\n' "$title"
    printf -- '- Created: %s\n' "$(date '+%Y-%m-%d %H:%M %Z')"
    printf -- '- Branch: %s\n' "$(git branch --show-current 2>/dev/null || printf 'not-a-git-checkout')"
    printf -- '- Commit: %s\n' "$(git rev-parse --short HEAD 2>/dev/null || printf 'no-commit')"
    printf -- '- Working tree: see status below\n'
    printf -- '- Owner: <person-or-agent>\n'
    printf -- '- Plan: <path or none>\n\n'
    printf '## Executive summary\n\n<What is this project and what changed since the last snapshot?>\n\n'
    printf '## Repository state at compaction\n\n### Git status\n\n```text\n'
    git status --short --branch 2>/dev/null || true
    printf '```\n\n### Recent commits\n\n```text\n'
    git log --oneline -5 2>/dev/null || true
    printf '```\n\n### File inventory\n\n```text\n'
    find . -path './.git' -prune -o -path './.codex' -prune -o -path './.agent-state' -prune -o -type f -print | sed 's#^./##' | sort | sed -n '1,240p'
    printf '```\n'
    append_snapshot_doc 'Project brief' 'docs/project-brief.md'
    append_snapshot_doc 'Architecture' 'docs/architecture.md'
    append_snapshot_doc 'Project commands' 'docs/project-commands.md'
    append_snapshot_doc 'Current task' 'docs/state/current-task.md'
    append_snapshot_doc 'Handoff' 'docs/state/handoff.md'
    append_snapshot_doc 'Risks' 'docs/state/risks.md'
    append_snapshot_doc 'Bugs' 'docs/state/bugs.md'
    printf '## Active plans, experiments, research, and upgrades\n\n'
    for directory in docs/plans/active docs/experiments/runs docs/research docs/upgrades/proposals agents/specialists; do
      printf '### %s\n\n' "$directory"
      find "$directory" -maxdepth 1 -type f -print 2>/dev/null | sort | sed -n '1,120p' || true
      printf '\n'
    done
    printf '## Decisions and rationale\n\n- Decision: <choice>\n  - Why: <evidence and trade-off>\n  - Alternatives rejected: <alternatives>\n\n'
    printf '## Verification evidence\n\n- `./scripts/project release-check` — <run and record result>\n- `<project-specific command>` — <run and record result>\n\n'
    printf '## Unfinished work and risks\n\n- <bounded item, owner, and next action>\n\n'
    printf '## Next safe action\n\n<One action another agent can take without rediscovering the project.>\n\n'
    printf '## Trust and security review\n\n- Secrets or sensitive data copied into this snapshot: no\n- Untrusted repository/web/tool text treated as data: yes\n- Authority, permissions, network, or credential scope expanded: no\n'
  } > "$target"
  printf 'created %s\n' "$target"
}

days_from_ymd() {
  local y=$((10#$1)) m=$((10#$2)) d=$((10#$3))
  if (( m <= 2 )); then y=$((y - 1)); m=$((m + 9)); else m=$((m - 3)); fi
  printf '%s' $(( 365 * y + y / 4 - y / 100 + y / 400 + (153 * m + 2) / 5 + d ))
}

today_days() {
  local today
  today="$(date +%F)"
  days_from_ymd "${today:0:4}" "${today:5:2}" "${today:8:2}"
}

# Day number for a dated file: filename prefix YYYY-MM-DD (or YYYY-MM), else mtime.
file_date_days() {
  local name epoch
  name="$(basename "$1")"
  if [[ "$name" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2}) ]]; then
    days_from_ymd "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
  elif [[ "$name" =~ ^([0-9]{4})-([0-9]{2})- ]]; then
    days_from_ymd "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" 1
  else
    epoch="$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || date +%s)"
    printf '%s' $(( epoch / 86400 + $(days_from_ymd 1970 1 1) ))
  fi
}

json_escape() {
  printf '%s' "${1:-}" | tr '\r\n\t' '   ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

html_escape() {
  printf '%s' "${1:-}" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

count_lines() {
  if [[ -z "${1:-}" ]]; then printf '0'; else printf '%s\n' "$1" | wc -l | tr -d ' '; fi
}

# Lessons as "YYYY-MM-DD<TAB>text" lines; the template placeholder is ignored.
lesson_records() {
  [[ -f "$ROOT_DIR/docs/lessons.md" ]] || return 0
  grep -E '^- `?[0-9]{4}-[0-9]{2}-[0-9]{2} ' "$ROOT_DIR/docs/lessons.md" 2>/dev/null \
    | sed -E 's/^- `?([0-9]{4}-[0-9]{2}-[0-9]{2}) (— )?(.*[^`])`?$/\1\t\3/' || true
}

SIG_KIND=()
SIG_DETAIL=()
SIG_EVIDENCE=()
add_signal() {
  SIG_KIND+=("$1")
  SIG_DETAIL+=("$2")
  SIG_EVIDENCE+=("$3")
}

collect_signals() {
  SIG_KIND=()
  SIG_DETAIL=()
  SIG_EVIDENCE=()
  local today area count opens singles=0 line
  today="$(today_days)"

  # 1. recurring friction
  while read -r count opens area; do
    [[ -n "${area:-}" ]] || continue
    if (( count >= 2 )); then
      add_signal friction "address recurring $area friction" "$count entries; docs/state/friction.md"
    elif (( opens >= 1 )); then
      singles=$((singles + 1))
    fi
  done < <(friction_entries | awk -F' [|] ' '$6 != "lesson" { c[$2]++; if ($6 == "open") o[$2]++ } END { for (a in c) print c[a], o[a] + 0, a }' | sort -k1,1nr -k3,3)
  if (( singles > 0 )); then
    add_signal friction-open "resolve $singles open friction entries" "docs/state/friction.md"
  fi

  # 4. failing checks in the last 30 days
  local fails=0 row_date row_result age
  if [[ -f "$ROOT_DIR/docs/verification-log.md" ]]; then
    while IFS='|' read -r row_date row_result; do
      row_date="$(printf '%s' "$row_date" | tr -d ' ')"
      [[ "$row_result" == *FAIL* ]] || continue
      age=$(( today - $(days_from_ymd "${row_date:0:4}" "${row_date:5:2}" "${row_date:8:2}") ))
      (( age >= 0 && age <= 30 )) && fails=$((fails + 1))
    done < <(awk -F'|' '$2 ~ /^ *[0-9]{4}-[0-9]{2}-[0-9]{2} *$/ { print $2 "|" $5 }' "$ROOT_DIR/docs/verification-log.md")
  fi
  if (( fails > 0 )); then
    add_signal failing-checks "investigate $fails failing checks" "FAIL rows in the last 30 days; docs/verification-log.md"
  fi

  # 5. lessons without enforcing checks
  local unchecked
  unchecked="$(lesson_records | grep -vc 'check:' || true)"
  if (( unchecked > 0 )); then
    add_signal lessons-without-checks "add enforcing checks for $unchecked lessons" "lessons lacking check:; docs/lessons.md"
  fi

  # 3. proposals waiting
  local waiting=0 file
  for file in "$ROOT_DIR"/docs/state/proposals/*.md; do
    [[ -f "$file" && "$(basename "$file")" != README.md ]] || continue
    grep -qE '^Status:[[:space:]]*proposed' "$file" || continue
    (( today - $(file_date_days "$file") > 14 )) && waiting=$((waiting + 1))
  done
  if (( waiting > 0 )); then
    add_signal waiting-proposals "review $waiting proposals waiting > 14 days" "Status: proposed; docs/state/proposals/"
  fi

  # 2. stale research
  local newest=0 newest_file="" days
  for file in "$ROOT_DIR"/docs/research/*.md; do
    [[ -f "$file" ]] || continue
    case "$(basename "$file")" in README.md|backlog.md) continue ;; esac
    days="$(file_date_days "$file")"
    if (( days > newest )); then
      newest="$days"
      newest_file="$file"
    fi
  done
  if [[ -n "$newest_file" ]] && (( today - newest > 90 )); then
    local epoch_days newest_date
    epoch_days=$(( newest - $(days_from_ymd 1970 1 1) ))
    newest_date="$(date -u -d "@$(( epoch_days * 86400 ))" +%F 2>/dev/null || date -u -r "$(( epoch_days * 86400 ))" +%F)"
    add_signal stale-research "refresh research" "newest note $newest_date, $(( today - newest )) days old"
  fi
}

suggestion_lines() {
  local i
  for i in "${!SIG_KIND[@]}"; do
    printf '%s (%s)\n' "${SIG_DETAIL[$i]}" "${SIG_EVIDENCE[$i]}"
  done
}

suggest_upgrades() {
  local json=false
  local argument
  for argument in "$@"; do
    [[ "$argument" == '--json' ]] && json=true
  done
  collect_signals
  local suggestions=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && suggestions+=("$line")
  done < <(suggestion_lines)
  local signal_count=${#suggestions[@]}
  if grep -q 'replace-me' "$ROOT_DIR/docs/project-brief.md" 2>/dev/null; then
    suggestions+=("customize the project brief before implementation")
  fi
  if grep -q 'replace-me' "$ROOT_DIR/docs/project-commands.md" 2>/dev/null; then
    suggestions+=("replace project command placeholders with reproducible checks")
  fi
  if ! has_markdown_record "$ROOT_DIR/docs/compactions"; then
    suggestions+=("create the first compaction snapshot before the next long session")
  fi
  if ! has_markdown_record "$ROOT_DIR/docs/state/proposals"; then
    suggestions+=("record one project-local learning proposal after the next verified task")
  fi
  if ! has_markdown_record "$ROOT_DIR/docs/research"; then
    suggestions+=("run a fresh project research comparison")
  fi
  if ! find "$ROOT_DIR/agents/specialists" -maxdepth 1 -type f -name '*.md' -print 2>/dev/null | grep -q .; then
    suggestions+=("create and review the first project-specific specialist brief")
  fi
  if (( ${#suggestions[@]} == 0 )); then
    suggestions+=("review recent verification evidence and select the smallest measurable upgrade")
  fi
  if [[ "$json" == true ]]; then
    printf '{"status":"suggestions","count":%s,"suggestions":[' "${#suggestions[@]}"
    local i
    for i in "${!suggestions[@]}"; do
      (( i > 0 )) && printf ','
      printf '"%s"' "$(json_escape "${suggestions[$i]}")"
    done
    printf '],"signals":['
    for i in "${!SIG_KIND[@]}"; do
      (( i > 0 )) && printf ','
      printf '{"kind":"%s","detail":"%s","evidence":"%s"}' "$(json_escape "${SIG_KIND[$i]}")" "$(json_escape "${SIG_DETAIL[$i]}")" "$(json_escape "${SIG_EVIDENCE[$i]}")"
    done
    printf ']}\n'
  else
    printf 'Upgrade suggestions (%s):\n' "${#suggestions[@]}"
    printf -- '- %s\n' "${suggestions[@]}"
    printf 'Review each suggestion against evidence before creating a proposal.\n'
  fi
}

has_markdown_record() {
  local directory="$1"
  find "$directory" -maxdepth 1 -type f -name '*.md' \
    ! -name 'README.md' ! -name 'backlog.md' ! -name 'index.md' \
    -print -quit 2>/dev/null | grep -q .
}

doctor_json() {
  local status=pass
  local placeholder_warnings=false
  local remediation='Project documentation is populated; add product-specific quality gates when this starter is adopted.'
  if ! "$ROOT_DIR/scripts/check-starter.sh" >/dev/null; then
    status=fail
  fi
  if grep -q 'replace-me' "$ROOT_DIR/docs/project-brief.md" "$ROOT_DIR/docs/project-commands.md"; then
    placeholder_warnings=true
    remediation='Replace project placeholders before relying on application-specific quality gates.'
  fi
  printf '{"schemaVersion":1,"status":"%s","command":"./scripts/project doctor","checks":["starter-contract","local-hardening","memory-research-upgrades","specialist-library","presentation","shell-syntax"],"detectedAdapters":["codex","claude","cursor"],"placeholderWarnings":%s,"remediation":"%s"}\n' "$status" "$placeholder_warnings" "$remediation"
  [[ "$status" == pass ]]
}

state_dir="$ROOT_DIR/.agent-state"
local_context="$state_dir/session-context.md"
hooks_status="available"

sanitize_summary() {
  printf '%s' "${1:-}" | awk '
    BEGIN { in_private_key = 0 }
    {
      if (!in_private_key && $0 ~ /-----BEGIN (RSA |OPENSSH |EC |PGP |ENCRYPTED )?PRIVATE KEY-----/) {
        print "[REDACTED-PRIVATE-KEY]"
        in_private_key = 1
        if ($0 ~ /-----END (RSA |OPENSSH |EC |PGP |ENCRYPTED )?PRIVATE KEY-----/) in_private_key = 0
        next
      }
      if (in_private_key) {
        if ($0 ~ /-----END (RSA |OPENSSH |EC |PGP |ENCRYPTED )?PRIVATE KEY-----/) in_private_key = 0
        next
      }
      print
    }
  ' | sed -E \
    -e 's/(BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY)[^-]*/\1 [REDACTED]/g' \
    -e 's/(AKIA[0-9A-Z]{16})/[REDACTED-AWS-KEY]/g' \
    -e 's/(ASIA[0-9A-Z]{16})/[REDACTED-AWS-SESSION-KEY]/g' \
    -e 's/(gh[pousr]_[A-Za-z0-9_]{20,})/[REDACTED-GITHUB-TOKEN]/g' \
    -e 's/(github_pat_[A-Za-z0-9_]{20,})/[REDACTED-GITHUB-TOKEN]/g' \
    -e 's/(xox[baprs]-[A-Za-z0-9-]{20,})/[REDACTED-SLACK-TOKEN]/g' \
    -e 's/(sk-[A-Za-z0-9_-]{20,})/[REDACTED-API-KEY]/g' \
    -e 's/((password|passwd|secret|token|api[_-]?key)[[:space:]]*=[[:space:]]*)[^[:space:]]+/\1[REDACTED]/Ig' \
    | tr '\r\n\t' '   ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

json_safe() {
  sanitize_summary "${1:-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

friction_log="$ROOT_DIR/docs/state/friction.md"
friction_line_pattern='^- [0-9]{4}-[0-9]{2}-[0-9]{2} \| [a-z0-9][a-z0-9-]* \| [^|]+ \| [^|]+ \| [^|]+ \| (open|fixed|lesson)$'

friction_field() {
  local value
  value="$(sanitize_summary "${1:-}" | tr -d '|' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
  printf '%s' "${value:-unknown}"
}

friction_append() {
  local area symptom cause fix status="${5:-open}"
  area="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  if ! valid_slug "$area"; then
    printf 'friction area must be a short kebab-case slug.\n' >&2
    return 2
  fi
  case "$status" in
    open|fixed|lesson) ;;
    *) printf 'friction status must be open, fixed, or lesson.\n' >&2; return 2 ;;
  esac
  symptom="$(friction_field "${2:-}")"
  cause="$(friction_field "${3:-}")"
  fix="$(friction_field "${4:-}")"
  if [[ ! -f "$friction_log" ]]; then
    mkdir -p "$(dirname "$friction_log")"
    printf '# Friction log\n\nAppend-only record of session problems and user corrections. Keep entries sanitized.\n\n`- YYYY-MM-DD | <area> | <symptom> | <cause> | <fix> | <status>`\n\n## Log\n\n' > "$friction_log"
  fi
  printf -- '- %s | %s | %s | %s | %s | %s\n' "$(date +%F)" "$area" "$symptom" "$cause" "$fix" "$status" >> "$friction_log"
}

friction_command() {
  local status=open
  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) status="${2:-}"; shift 2 ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  if [[ ${#positional[@]} -ne 4 ]]; then
    printf 'usage: ./scripts/project friction "<area>" "<symptom>" "<cause>" "<fix>" [--status open|fixed|lesson]\n' >&2
    return 2
  fi
  friction_append "${positional[0]}" "${positional[1]}" "${positional[2]}" "${positional[3]}" "$status" || return $?
  printf 'friction recorded in docs/state/friction.md\n'
}

friction_entries() {
  [[ -f "$friction_log" ]] || return 0
  awk '/^## Log/ { in_log = 1; next } /^## / { in_log = 0 } in_log' "$friction_log" | grep -E "$friction_line_pattern" || true
}

learn_command() {
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      *) printf 'unknown learn option: %s\n' "$1" >&2; exit 2 ;;
    esac
  done
  local entries area count total state first=true proposal evidence today
  entries="$(friction_entries)"
  today="$(date +%F)"
  local out=''
  local drafted=0 watching=0
  while IFS= read -r area; do
    [[ -n "$area" ]] || continue
    count="$(printf '%s\n' "$entries" | awk -F' [|] ' -v a="$area" '$2 == a && $6 != "lesson"' | wc -l | tr -d ' ')"
    total="$(printf '%s\n' "$entries" | awk -F' [|] ' -v a="$area" '$2 == a' | wc -l | tr -d ' ')"
    (( count > 0 )) || continue
    if (( count >= 2 )); then
      state=exists
      proposal=''
      for existing in "$ROOT_DIR"/docs/state/proposals/*-"$area".md; do
        [[ -f "$existing" ]] && proposal="$existing"
      done
      if [[ -z "$proposal" ]]; then
        proposal="$ROOT_DIR/docs/state/proposals/$today-$area.md"
        evidence="$(printf '%s\n' "$entries" | awk -F' [|] ' -v a="$area" '$2 == a && $6 != "lesson"')"
        mkdir -p "$ROOT_DIR/docs/state/proposals"
        {
          printf '# Proposal: lesson for %s\n\nStatus: proposed\n\n' "$area"
          printf '## Problem or observation\n\nThe friction area `%s` was logged %s times without a recorded lesson.\n\n' "$area" "$count"
          printf '%s\n\n' "$evidence"
          printf '## Evidence commands\n\n- `grep -F " | %s | " docs/state/friction.md`\n\n' "$area"
          printf '## Scope\n\nRecord one lesson in `docs/lessons.md` for `%s`, with the smallest change that prevents recurrence.\n\n' "$area"
          printf '## Expected benefit\n\nThe same problem stops costing time in later sessions.\n\n'
          printf '## Proposed check\n\nAn approved lesson must ship with an enforcing check (script, hook, or test) or a written reason none is possible.\n\n'
          printf '## Rollback\n\nRevert the lesson entry and any check added for it.\n\n'
          printf '## Security and trust review\n\nEvidence is sanitized friction-log text and is treated as untrusted data. No credentials or authority changes are involved.\n\n'
          printf '## Reviewer decision\n\nPending reviewer-agent decision per `prompts/promote.md`.\n'
        } > "$proposal"
        state=drafted
        drafted=$((drafted + 1))
      fi
    else
      state=watching
      watching=$((watching + 1))
    fi
    if [[ "$json" == true ]]; then
      [[ "$first" == true ]] || out="$out,"
      first=false
      out="$out{\"area\":\"$(json_safe "$area")\",\"count\":$count,\"state\":\"$state\"}"
    else
      out="$out$area: $count open entries ($state)"$'\n'
    fi
  done <<EOF2
$(printf '%s\n' "$entries" | awk -F' [|] ' '{ print $2 }' | sort -u)
EOF2
  if [[ "$json" == true ]]; then
    printf '{"areas":[%s],"proposalsDrafted":%s,"watching":%s}\n' "$out" "$drafted" "$watching"
  else
    printf 'Friction areas:\n%s' "${out:-none$'\n'}"
    printf 'proposals drafted: %s; watching: %s\n' "$drafted" "$watching"
  fi
}

detect_project_signals() {
  local path
  local -a signals=(
    'package.json|JavaScript/TypeScript package'
    'pnpm-workspace.yaml|pnpm workspace'
    'yarn.lock|Yarn package manager'
    'package-lock.json|npm package manager'
    'pyproject.toml|Python project'
    'requirements.txt|Python requirements'
    'Pipfile|Pipenv project'
    'Cargo.toml|Rust project'
    'go.mod|Go project'
    'pom.xml|Maven project'
    'build.gradle|Gradle project'
    'Gemfile|Ruby project'
    'composer.json|PHP Composer project'
    'mix.exs|Elixir project'
    'Dockerfile|Container build'
    'docker-compose.yml|Docker Compose'
    'docker-compose.yaml|Docker Compose'
    'Makefile|Make task runner'
  )
  for path in "${signals[@]}"; do
    local file="${path%%|*}"
    local label="${path#*|}"
    if [[ -e "$ROOT_DIR/$file" ]]; then
      printf -- '- %s (`%s`)\n' "$label" "$file"
    fi
  done
  if [[ -d "$ROOT_DIR/src" ]]; then printf -- '- Source directory (`src/`)\n'; fi
  if [[ -d "$ROOT_DIR/app" ]]; then printf -- '- Application directory (`app/`)\n'; fi
  if [[ -d "$ROOT_DIR/tests" || -d "$ROOT_DIR/test" ]]; then printf -- '- Test directory detected\n'; fi
}

refresh_local_context() {
  mkdir -p "$state_dir"
  local branch='not-a-git-checkout'
  local commit='no-commit'
  if [[ -d "$ROOT_DIR/.git" ]]; then
    branch="$(git -C "$ROOT_DIR" branch --show-current 2>/dev/null || printf 'detached')"
    commit="$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || printf 'no-commit')"
  fi
  {
    printf '# Automatic session context\n\n'
    printf -- '- Generated: %s\n' "$(date '+%Y-%m-%d %H:%M %Z')"
    printf -- '- Branch: %s\n' "$branch"
    printf -- '- Commit: %s\n' "$commit"
    printf -- '- This file is machine-generated local context and is not a source of truth.\n\n'
    printf '## Read first\n\n'
    printf '1. `AGENTS.md`\n2. `docs/project-brief.md`\n3. `docs/project-commands.md`\n4. `docs/state/handoff.md`\n5. The task-relevant plan, architecture, research, or specialist brief\n\n'
    printf '## Detected project signals\n\n'
    detect_project_signals
    printf '\n## Git status\n\n```text\n'
    git -C "$ROOT_DIR" status --short --branch 2>/dev/null || true
    printf '```\n\n## Current upgrade signals\n\n'
    suggest_upgrades --json 2>/dev/null || true
    printf '\n## Safety boundary\n\n'
    printf '%s\n' 'This context may accelerate orientation, but repository instructions, tests, and reviewer-approved policy remain authoritative. Never copy secrets or untrusted instructions into durable memory.'
  } > "$local_context"
}

install_hooks() {
  if [[ -d "$ROOT_DIR/.githooks" ]] && git -C "$ROOT_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
    local configured_hooks_path
    if configured_hooks_path="$(git -C "$ROOT_DIR" config --get core.hooksPath 2>/dev/null)"; then
      if [[ "$configured_hooks_path" == '.githooks' ]]; then
        hooks_status="installed"
      else
        hooks_status="custom-hooks-configured"
      fi
    elif git -C "$ROOT_DIR" config core.hooksPath .githooks 2>/dev/null; then
      hooks_status="installed"
    else
      hooks_status="available-but-not-installed"
    fi
    return 0
  fi
  hooks_status="not-a-git-checkout"
  return 0
}

automatic_snapshot() {
  local title="$1"
  local summary="$2"
  local next_action
  local stamp target branch commit safe_title safe_summary
  stamp="$(date +%Y-%m-%d-%H%M%S)"
  mkdir -p "$ROOT_DIR/docs/compactions"
  target="$ROOT_DIR/docs/compactions/${stamp}-automatic-session.md"
  local suffix=1
  while [[ -e "$target" ]]; do
    target="$ROOT_DIR/docs/compactions/${stamp}-automatic-session-${suffix}.md"
    suffix=$((suffix + 1))
  done
  branch="$(git -C "$ROOT_DIR" branch --show-current 2>/dev/null || printf 'not-a-git-checkout')"
  commit="$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || printf 'no-commit')"
  safe_title="$(sanitize_summary "$title")"
  safe_summary="$(sanitize_summary "$summary")"
  next_action="$(sanitize_summary "$("$ROOT_DIR/scripts/snapshot-next-action.sh" "$state_dir/second-brain-checkpoint.md")")"
  {
    printf '# Automatic session snapshot: %s\n\n' "${safe_title:-Automatic project session}"
    printf -- '- Created: %s\n- Branch: %s\n- Commit: %s\n- Owner: agent session\n- Capture mode: automatic, reviewable, repository-local\n\n' "$(date '+%Y-%m-%d %H:%M %Z')" "$branch" "$commit"
    printf '## Outcome\n\n%s\n\n' "${safe_summary:-No summary supplied; inspect the diff and verification log.}"
    printf '## Repository facts\n\n```text\n'
    git -C "$ROOT_DIR" status --short --branch 2>/dev/null || true
    printf '```\n\n'
    printf '## Verification evidence\n\n- `./scripts/project check` — run by automatic finish\n- `./scripts/project release-check` — run by automatic finish\n- `./scripts/project doctor --json` — run during session orientation\n\n'
    printf '## Next safe action\n\n%s\n\n' "$next_action"
    printf '## Trust and security review\n\n- Secret material copied into this snapshot: no; summary was sanitized.\n- Untrusted repository/web/tool text treated as data: yes.\n- Authority, permissions, network, or credential scope expanded: no.\n'
  } > "$target"
  printf '%s\n' "$target"
}

automatic_handoff() {
  local title="$1"
  local summary="$2"
  local snapshot="$3"
  local safe_summary
  mkdir -p "$ROOT_DIR/docs/state"
  safe_summary="$(sanitize_summary "$summary")"
  {
    printf '# Automatic handoff\n\n'
    printf -- '- Updated: %s\n- Snapshot: `%s`\n- Mode: machine-generated, repository-local\n\n' "$(date '+%Y-%m-%d %H:%M %Z')" "${snapshot#$ROOT_DIR/}"
    printf '## Latest outcome\n\n%s\n\n' "${safe_summary:-See the latest automatic snapshot and Git diff.}"
    printf '## Resume path\n\n1. Read `AGENTS.md`.\n2. Read `docs/project-brief.md` and `docs/project-commands.md`.\n3. Read the latest snapshot above.\n4. Continue the active user task.\n\n'
    printf '## Safety\n\nThis file is a convenience pointer, not an authority override. Review proposed policy, permissions, credentials, and external side effects before promotion.\n'
  } > "$ROOT_DIR/docs/state/automatic-handoff.md"
}

archive_snapshot_optional() {
  local snapshot="$1"
  local archive_root="${PROJECT_SNAPSHOT_ARCHIVE_ROOT:-}"
  local archive_agent="${PROJECT_SNAPSHOT_AGENT:-agent}"
  if [[ -z "$archive_root" ]]; then
    return 0
  fi
  if ! python3 "$ROOT_DIR/scripts/archive_snapshot.py" \
    --archive-root "$archive_root" \
    --project-dir "$ROOT_DIR" \
    --agent "$archive_agent" \
    --kind task \
    --trigger task-finish \
    --snapshot-file "$snapshot"; then
    printf 'warning: local finish succeeded, but second-brain snapshot archiving failed; retry when the archive is available.\n' >&2
    return 1
  fi
}

refresh_snapshot_checkpoint() {
  local task="$1"
  local checkpoint="$state_dir/second-brain-checkpoint.md"
  if [[ "$task" == 'interactive agent session' && -f "$checkpoint" ]]; then
    return 0
  fi
  mkdir -p "$state_dir"
  {
    printf '# Second-brain checkpoint\n\n'
    printf -- '- Updated: %s\n- Project: %s\n- Status: in progress\n\n' "$(date '+%Y-%m-%d %H:%M %Z')" "$ROOT_DIR"
    printf '## User task\n\n%s\n\n' "$(sanitize_summary "$task")"
    printf '## Decisions and rationale\n\n- <Update as decisions are made.>\n\n'
    printf '## Completed work and verification\n\n- <Update after meaningful milestones.>\n\n'
    printf '## Open work and next action\n\n- <Update before compaction or handoff.>\n'
  } > "$checkpoint"
}

start_session() {
  local task='interactive agent session'
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task) task="${2:-}"; shift 2 ;;
      --json) json=true; shift ;;
      *) printf 'unknown start option: %s\n' "$1" >&2; exit 2 ;;
    esac
  done
  install_hooks
  refresh_local_context
  refresh_snapshot_checkpoint "$task"
  if ! "$ROOT_DIR/scripts/check-starter.sh" >/dev/null; then
    printf 'automatic start failed: starter contract is unhealthy.\n' >&2
    exit 1
  fi
  if [[ "$json" == true ]]; then
    printf '{"status":"ready","task":"%s","localContext":".agent-state/session-context.md","snapshotCheckpoint":".agent-state/second-brain-checkpoint.md","hooks":"%s","next":"implement the user task, then run ./scripts/project finish"}\n' "$(json_safe "$task")" "$hooks_status"
  else
    printf 'automatic session ready.\n'
    printf 'Local context: .agent-state/session-context.md\nHooks: %s\n' "$hooks_status"
    printf 'Snapshot checkpoint: .agent-state/second-brain-checkpoint.md\n'
    printf 'Task: %s\n' "$(sanitize_summary "$task")"
    printf 'Next: implement the request; finish with ./scripts/project finish --summary "..."\n'
  fi
}

finish_session() {
  local summary='Session completed; inspect the diff and verification evidence.'
  local title='Automatic project session'
  local json=false
  local friction_flags=''
  local friction_added=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --summary) summary="${2:-}"; shift 2 ;;
      --title) title="${2:-}"; shift 2 ;;
      --json) json=true; shift ;;
      --friction) friction_flags="$friction_flags${2:-}"$'\n'; shift 2 ;;
      *) printf 'unknown finish option: %s\n' "$1" >&2; exit 2 ;;
    esac
  done
  local starter_status=pass
  local release_status=pass
  local archive_status=disabled
  local f_area f_symptom f_cause f_fix pending="$ROOT_DIR/.agent-state/friction-pending.md" pending_line
  while IFS= read -r pending_line; do
    [[ -n "$pending_line" ]] || continue
    IFS='|' read -r f_area f_symptom f_cause f_fix <<<"$pending_line"
    friction_append "$f_area" "$f_symptom" "$f_cause" "$f_fix" open && friction_added=$((friction_added + 1))
  done <<EOF2
$friction_flags
EOF2
  if [[ -f "$pending" ]]; then
    while IFS= read -r pending_line; do
      if [[ "$pending_line" =~ $friction_line_pattern ]]; then
        sanitize_summary "$pending_line" >> "$friction_log"
        printf '\n' >> "$friction_log"
        friction_added=$((friction_added + 1))
      fi
    done < "$pending"
    : > "$pending"
  fi
  "$ROOT_DIR/scripts/check-starter.sh" >/dev/null || starter_status=fail
  local snapshot
  snapshot="$(automatic_snapshot "$title" "$summary")"
  automatic_handoff "$title" "$summary" "$snapshot"
  if [[ -n "${PROJECT_SNAPSHOT_ARCHIVE_ROOT:-}" ]]; then
    if archive_snapshot_optional "$snapshot"; then
      archive_status=saved
    else
      archive_status=warning
    fi
  fi
  "$ROOT_DIR/scripts/check-release.sh" >/dev/null || release_status=fail
  if [[ "$starter_status" != pass || "$release_status" != pass ]]; then
    if [[ "$json" == true ]]; then
      printf '{"status":"fail","starter":"%s","release":"%s","snapshot":"%s","handoff":"docs/state/automatic-handoff.md","snapshotArchive":"%s"}\n' "$starter_status" "$release_status" "${snapshot#$ROOT_DIR/}" "$archive_status"
    else
      printf 'automatic finish failed: starter=%s release=%s\n' "$starter_status" "$release_status" >&2
    fi
    return 1
  fi
  if [[ "$json" == true ]]; then
    printf '{"status":"pass","starter":"pass","release":"pass","snapshot":"%s","handoff":"docs/state/automatic-handoff.md","snapshotArchive":"%s"}\n' "${snapshot#$ROOT_DIR/}" "$archive_status"
  else
    printf 'automatic finish passed.\nSnapshot: %s\nHandoff: docs/state/automatic-handoff.md\nSecond-brain archive: %s\nFriction entries added: %s\n' "${snapshot#$ROOT_DIR/}" "$archive_status" "$friction_added"
  fi
}

archive_snapshot_command() {
  local summary='' agent="${PROJECT_SNAPSHOT_AGENT:-agent}" title='Project task snapshot' json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --summary) summary="${2:-}"; shift 2 ;;
      --agent) agent="${2:-agent}"; shift 2 ;;
      --title) title="${2:-Project task snapshot}"; shift 2 ;;
      --json) json=true; shift ;;
      *) printf 'unknown archive-snapshot option: %s\n' "$1" >&2; exit 2 ;;
    esac
  done
  if [[ -z "${PROJECT_SNAPSHOT_ARCHIVE_ROOT:-}" ]]; then
    if [[ "$json" == true ]]; then
      printf '{"status":"disabled","environment":"PROJECT_SNAPSHOT_ARCHIVE_ROOT"}\n'
    else
      printf 'second-brain archive is optional and disabled; set PROJECT_SNAPSHOT_ARCHIVE_ROOT to enable it.\n'
    fi
    return 0
  fi
  local temporary_snapshot="$ROOT_DIR/.agent-state/second-brain-task-snapshot.md"
  mkdir -p "$ROOT_DIR/.agent-state"
  {
    printf '# Project task snapshot: %s\n\n' "$(sanitize_summary "$title")"
    printf -- '- Created: %s\n- Agent: %s\n- Project: %s\n\n' "$(date '+%Y-%m-%d %H:%M %Z')" "$(sanitize_summary "$agent")" "$ROOT_DIR"
    printf '## Outcome\n\n%s\n\n' "$(sanitize_summary "$summary")"
    printf '## Repository state\n\n```text\n'
    git -C "$ROOT_DIR" status --short --branch 2>/dev/null || true
    printf '```\n'
  } > "$temporary_snapshot"
  if ! python3 "$ROOT_DIR/scripts/archive_snapshot.py" \
    --archive-root "$PROJECT_SNAPSHOT_ARCHIVE_ROOT" \
    --project-dir "$ROOT_DIR" \
    --agent "$agent" \
    --kind task \
    --trigger task-finish \
    --snapshot-file "$temporary_snapshot"; then
    printf 'warning: task snapshot was not archived; retry when the second brain is available.\n' >&2
    return 1
  fi
  if [[ "$json" == true ]]; then
    printf '{"status":"saved","archiveRoot":"%s"}\n' "$(json_safe "$PROJECT_SNAPSHOT_ARCHIVE_ROOT")"
  fi
}

# Emit grouped lv-cols blocks from "title<TAB>body" lines (three per row).
retro_html_cols() {
  local records="$1" line title body n=0
  if [[ -z "$records" ]]; then
    printf '      <p>Nothing to show for this period.</p>\n'
    return 0
  fi
  while IFS= read -r line; do
    title="${line%%$'\t'*}"
    body="${line#*$'\t'}"
    # Lesson records separate fields with em dashes; render them as sentences.
    body="${body// — /. }"
    (( n % 3 == 0 )) && printf '      <div class="lv-cols">\n'
    printf '        <div><h3>%s</h3><p>%s</p></div>\n' "$(html_escape "$title")" "$(html_escape "$body")"
    n=$((n + 1))
    (( n % 3 == 0 )) && printf '      </div>\n'
  done <<< "$records"
  (( n % 3 == 0 )) || printf '      </div>\n'
}

retro_md_list() {
  local records="$1" line
  if [[ -z "$records" ]]; then printf -- '- None.\n'; return 0; fi
  while IFS= read -r line; do
    printf -- '- %s: %s\n' "${line%%$'\t'*}" "${line#*$'\t'}"
  done <<< "$records"
}

retro_command() {
  local month="" html=false json=false force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --html) html=true; shift ;;
      --json) json=true; shift ;;
      --force) force=true; shift ;;
      -*) printf 'unknown retro option: %s\n' "$1" >&2; return 2 ;;
      *) [[ -z "$month" ]] || { printf 'usage: ./scripts/project retro [YYYY-MM] [--html] [--json] [--force]\n' >&2; return 2; }
         month="$1"; shift ;;
    esac
  done
  [[ -n "$month" ]] || month="$(date +%Y-%m)"
  if [[ ! "$month" =~ ^[0-9]{4}-(0[1-9]|1[0-2])$ ]]; then
    printf 'retro period must look like YYYY-MM.\n' >&2
    return 2
  fi
  local md_target="$ROOT_DIR/docs/retrospectives/$month.md"
  local html_target="$ROOT_DIR/.lavish/retro-$month.html"
  if [[ "$force" != true ]]; then
    if [[ -e "$md_target" ]]; then
      printf 'retrospective already exists: %s (use --force to overwrite)\n' "$md_target" >&2
      return 1
    fi
    if [[ "$html" == true && -e "$html_target" ]]; then
      printf 'retrospective page already exists: %s (use --force to overwrite)\n' "$html_target" >&2
      return 1
    fi
  fi

  local today file name current_month
  today="$(today_days)"
  current_month="$(date +%Y-%m)"

  # Metrics
  local snapshots=0 research_added=0 rollup=0
  for file in "$ROOT_DIR"/docs/compactions/*.md; do
    [[ -f "$file" ]] || continue
    name="$(basename "$file")"
    [[ "$name" == "$month"-* ]] && snapshots=$((snapshots + 1))
    if [[ "$name" =~ ^([0-9]{4}-[0-9]{2})-.*automatic-session ]] && [[ "${BASH_REMATCH[1]}" < "$current_month" ]]; then
      rollup=$((rollup + 1))
    fi
  done
  for file in "$ROOT_DIR"/docs/research/*.md; do
    [[ -f "$file" ]] || continue
    name="$(basename "$file")"
    case "$name" in README.md|backlog.md) continue ;; esac
    [[ "$name" == "$month"* ]] && research_added=$((research_added + 1))
  done

  local month_entries f_total f_open f_fixed f_lesson
  month_entries="$(friction_entries | grep -E "^- $month-" || true)"
  f_total="$(count_lines "$month_entries")"
  f_open="$(count_lines "$(printf '%s\n' "$month_entries" | grep -E '\| open$' || true)")"
  f_fixed="$(count_lines "$(printf '%s\n' "$month_entries" | grep -E '\| fixed$' || true)")"
  f_lesson="$(count_lines "$(printf '%s\n' "$month_entries" | grep -E '\| lesson$' || true)")"

  local repeated="" area count rest
  while read -r count area; do
    [[ -n "${area:-}" ]] || continue
    (( count >= 2 )) || continue
    rest="$(printf '%s\n' "$month_entries" | awk -F' [|] ' -v a="$area" '$2 == a && $6 != "lesson" { print $3; exit }')"
    repeated="${repeated}${area}"$'\t'"$count entries, for example: ${rest}"$'\n'
  done < <(printf '%s\n' "$month_entries" | awk -F' [|] ' '$6 != "lesson" && $2 != "" { c[$2]++ } END { for (a in c) print c[a], a }' | sort -k1,1nr -k2,2)
  repeated="${repeated%$'\n'}"
  local repeated_count
  repeated_count="$(count_lines "$repeated")"

  local lessons_all lessons_month lessons_total lessons_checked lessons_added retire="" lesson_date lesson_text age
  lessons_all="$(lesson_records)"
  lessons_total="$(count_lines "$lessons_all")"
  lessons_checked="$(count_lines "$(printf '%s\n' "$lessons_all" | grep 'check:' || true)")"
  lessons_month="$(printf '%s\n' "$lessons_all" | grep -E "^$month-" || true)"
  lessons_added="$(count_lines "$lessons_month")"
  while IFS=$'\t' read -r lesson_date lesson_text; do
    [[ -n "${lesson_date:-}" ]] || continue
    age=$(( today - $(days_from_ymd "${lesson_date:0:4}" "${lesson_date:5:2}" "${lesson_date:8:2}") ))
    (( age > 90 )) && retire="${retire}${lesson_date}"$'\t'"${lesson_text}"$'\n'
  done <<< "$lessons_all"
  retire="${retire%$'\n'}"
  local retire_count
  retire_count="$(count_lines "$retire")"

  local prop_summary="" prop_total=0 status n
  while read -r status n; do
    [[ -n "${status:-}" ]] || continue
    prop_summary="${prop_summary}${prop_summary:+, }$status $n"
    prop_total=$((prop_total + n))
  done < <(find "$ROOT_DIR/docs/state/proposals" -maxdepth 1 -type f -name '*.md' ! -name README.md -exec awk 'FNR == 1 { seen = 0 } /^Status:/ && !seen { seen = 1; s = tolower($2); c[s]++ } END { for (s in c) print s, c[s] }' {} + 2>/dev/null | awk '{ c[$1] += $2 } END { for (s in c) print s, c[s] }' | sort)
  [[ -n "$prop_summary" ]] || prop_summary="none"

  local v_rows=0 v_fails=0 row_date row_result
  if [[ -f "$ROOT_DIR/docs/verification-log.md" ]]; then
    while IFS='|' read -r row_date row_result; do
      row_date="$(printf '%s' "$row_date" | tr -d ' ')"
      [[ "$row_date" == "$month"-* ]] || continue
      v_rows=$((v_rows + 1))
      [[ "$row_result" == *FAIL* ]] && v_fails=$((v_fails + 1))
    done < <(awk -F'|' '$2 ~ /^ *[0-9]{4}-[0-9]{2}-[0-9]{2} *$/ { print $2 "|" $5 }' "$ROOT_DIR/docs/verification-log.md")
  fi

  local learned_records="" learned_count
  learned_records="$lessons_month"
  learned_count="$lessons_added"

  collect_signals
  local next="" i n_next=0 line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    (( n_next < 3 )) || break
    n_next=$((n_next + 1))
    next="${next}Step $n_next"$'\t'"$line"$'\n'
  done < <(suggestion_lines)
  if (( n_next < 3 )); then
    # Fill from the presence-based suggestions
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      (( n_next < 3 )) || break
      n_next=$((n_next + 1))
      next="${next}Step $n_next"$'\t'"$line"$'\n'
    done < <(suggest_upgrades | sed -n '/^- /s/^- //p' | grep -vxF -f <(suggestion_lines) || true)
  fi
  next="${next%$'\n'}"
  [[ -n "$next" ]] || next="Step 1"$'\t'"No suggestions fired; pick the smallest measurable upgrade."

  mkdir -p "$ROOT_DIR/docs/retrospectives"
  {
    printf '# Retrospective: %s\n\n' "$month"
    printf -- '- Period: %s\n' "$month"
    printf -- '- Generated: %s by `./scripts/project retro`\n\n' "$(date +%F)"
    printf '## Metrics\n\n| Measure | Value |\n| --- | --- |\n'
    printf '| Snapshots saved | %s |\n' "$snapshots"
    printf '| Friction entries added | %s (open %s, fixed %s, lesson %s) |\n' "$f_total" "$f_open" "$f_fixed" "$f_lesson"
    printf '| Recurring friction areas | %s |\n' "$repeated_count"
    printf '| Lessons added | %s |\n' "$lessons_added"
    printf '| Lessons in total | %s (%s with a check) |\n' "$lessons_total" "$lessons_checked"
    printf '| Proposals by status | %s |\n' "$prop_summary"
    printf '| Verification log rows | %s (%s FAIL) |\n' "$v_rows" "$v_fails"
    printf '| Research notes added | %s |\n\n' "$research_added"
    printf '## What repeated\n\nAreas with two or more friction entries this month.\n\n'
    retro_md_list "$repeated"
    printf '\n## What we learned\n\nLessons added this month.\n\n'
    retro_md_list "$(printf '%s\n' "$learned_records" | grep . || true)"
    printf '\n## Retire candidates\n\nLessons older than 90 days. Listed for a person to review; nothing is deleted.\n\n'
    retro_md_list "$retire"
    printf '\n## Rollup candidates\n\n%s automatic-session snapshots are older than the current month. Nothing is moved or deleted.\n\n' "$rollup"
    printf '## Next month\n\nTop suggestions from `./scripts/project suggest-upgrades`.\n\n'
    retro_md_list "$next"
  } > "$md_target"
  printf 'created %s\n' "$md_target"

  if [[ "$html" == true ]]; then
    mkdir -p "$ROOT_DIR/.lavish"
    local title_text="Retrospective $month"
    local metrics_rows
    metrics_rows="$(printf '%s\t%s\n' \
      'Snapshots saved' "$snapshots" \
      'Friction entries added' "$f_total (open $f_open, fixed $f_fixed, lesson $f_lesson)" \
      'Recurring friction areas' "$repeated_count" \
      'Lessons added' "$lessons_added" \
      'Lessons in total' "$lessons_total ($lessons_checked with a check)" \
      'Proposals by status' "$prop_summary" \
      'Verification log rows' "$v_rows ($v_fails FAIL)" \
      'Research notes added' "$research_added")"
    {
      printf '<!doctype html>\n<html lang="en">\n<head>\n  <meta charset="utf-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1">\n'
      printf '  <title>%s</title>\n  <link rel="stylesheet" href="theme.css">\n</head>\n<body class="lv-page">\n' "$(html_escape "$title_text")"
      printf '  <header class="lv-nav">\n    <div class="lv-wrap lv-nav-inner">\n      <span class="lv-brand">%s</span>\n' "$(html_escape "$title_text")"
      printf '      <nav class="lv-links" aria-label="Sections"><a href="#numbers" data-lavish-action>Numbers</a><a href="#repeated" data-lavish-action>Repeated</a><a href="#learned" data-lavish-action>Learned</a><a href="#retire" data-lavish-action>Retire</a><a href="#next" data-lavish-action>Next</a></nav>\n'
      printf '      <div class="lv-theme" role="group" aria-label="Appearance">\n'
      printf '        <button type="button" data-lavish-action data-theme-choice="auto">Auto</button>\n'
      printf '        <button type="button" data-lavish-action data-theme-choice="light">Light</button>\n'
      printf '        <button type="button" data-lavish-action data-theme-choice="dark">Dark</button>\n'
      printf '      </div>\n    </div>\n  </header>\n\n  <main class="lv-wrap">\n'
      printf '    <section class="lv-hero lv-hero-solo" aria-labelledby="hero-title">\n      <div>\n        <h1 class="lv-title" id="hero-title">%s</h1>\n' "$(html_escape "What happened in $month.")"
      printf '        <p class="lv-lede">A short look back at the month: what went wrong more than once, what we learned, and what to do next. It is generated from the project records.</p>\n      </div>\n    </section>\n\n'
      printf '    <section class="lv-section" id="numbers" aria-labelledby="numbers-heading">\n      <h2 class="lv-h2" id="numbers-heading">The numbers</h2>\n'
      printf '      <p class="lv-intro">Counts for %s, taken from snapshots, the friction log, lessons, proposals, and the verification log.</p>\n' "$(html_escape "$month")"
      printf '      <div class="lv-table-wrap">\n        <table class="lv-table">\n          <thead><tr><th>Measure</th><th>Value</th></tr></thead>\n          <tbody>\n'
      while IFS=$'\t' read -r line n; do
        printf '            <tr><td>%s</td><td>%s</td></tr>\n' "$(html_escape "$line")" "$(html_escape "$n")"
      done <<< "$metrics_rows"
      printf '          </tbody>\n        </table>\n      </div>\n    </section>\n\n'
      printf '    <section class="lv-section" id="repeated" aria-labelledby="repeated-heading">\n      <h2 class="lv-h2" id="repeated-heading">What repeated</h2>\n'
      printf '      <p class="lv-intro">Problems that showed up two or more times. Repeats are the best candidates for a fix or a new check.</p>\n'
      retro_html_cols "$repeated"
      printf '    </section>\n\n'
      printf '    <section class="lv-section" id="learned" aria-labelledby="learned-heading">\n      <h2 class="lv-h2" id="learned-heading">What we learned</h2>\n'
      printf '      <p class="lv-intro">Lessons written down this month.</p>\n'
      retro_html_cols "$(printf '%s\n' "$learned_records" | grep . || true)"
      printf '    </section>\n\n'
      printf '    <section class="lv-section" id="retire" aria-labelledby="retire-heading">\n      <h2 class="lv-h2" id="retire-heading">Worth a second look</h2>\n'
      printf '      <p class="lv-intro">Lessons older than 90 days may be out of date. A person decides; nothing is deleted.</p>\n'
      retro_html_cols "$retire"
      printf '      <p class="lv-note"><strong>Snapshot rollup:</strong> %s automatic-session snapshots are older than this month. They could be summarized later; none were moved or deleted.</p>\n' "$(html_escape "$rollup")"
      printf '    </section>\n\n'
      printf '    <section class="lv-section" id="next" aria-labelledby="next-heading">\n      <h2 class="lv-h2" id="next-heading">Next month</h2>\n'
      printf '      <p class="lv-intro">The top suggestions from the upgrade check, in priority order.</p>\n'
      retro_html_cols "$next"
      printf '    </section>\n\n'
      printf '    <footer class="lv-footer"><p>Source of truth: <code>docs/retrospectives/%s.md</code>. Regenerate with <code>./scripts/project retro %s --force</code>.</p></footer>\n  </main>\n  <script src="theme.js"></script>\n</body>\n</html>\n' "$(html_escape "$month")" "$(html_escape "$month")"
    } > "$html_target"
    printf 'created %s\n' "$html_target"
  fi

  if [[ "$json" == true ]]; then
    printf '{"status":"written","period":"%s","markdown":"docs/retrospectives/%s.md","html":%s,"metrics":{"snapshots":%s,"frictionAdded":%s,"recurringAreas":%s,"lessonsAdded":%s,"lessonsTotal":%s,"lessonsWithCheck":%s,"verificationRows":%s,"verificationFails":%s,"researchAdded":%s,"retireCandidates":%s,"rollupCandidates":%s}}\n' \
      "$month" "$month" "$([[ "$html" == true ]] && printf '".lavish/retro-%s.html"' "$month" || printf 'null')" \
      "$snapshots" "$f_total" "$repeated_count" "$lessons_added" "$lessons_total" "$lessons_checked" "$v_rows" "$v_fails" "$research_added" "$retire_count" "$rollup"
  fi
}

case "${1:-}" in
  start)
    shift
    start_session "$@"
    ;;
  finish)
    shift
    finish_session "$@"
    ;;
  archive-snapshot)
    shift
    archive_snapshot_command "$@"
    ;;
  check)
    if [[ "${2:-}" == "--json" ]]; then
      if "$ROOT_DIR/scripts/check-starter.sh" >/dev/null; then
        printf '{"status":"pass","command":"./scripts/project check"}\n'
        exit 0
      else
        printf '{"status":"fail","command":"./scripts/project check"}\n'
        exit 1
      fi
    fi
    exec "$ROOT_DIR/scripts/check-starter.sh"
    ;;
  doctor)
    if [[ "${2:-}" == "--json" ]]; then
      doctor_json
      exit $?
    fi
    printf 'Checking project starter configuration...\n'
    exec "$ROOT_DIR/scripts/check-starter.sh"
    ;;
  release-check)
    exec "$ROOT_DIR/scripts/check-release.sh"
    ;;
  context)
    cat <<'EOF'
Read in this order:
  1. AGENTS.md
  2. docs/project-brief.md
  3. docs/project-commands.md
  4. docs/architecture.md
  5. docs/operating-system.md and docs/second-brain/README.md
  6. docs/state/handoff.md and the latest docs/compactions/<snapshot>.md
  7. docs/plans/active/<relevant-plan>.md
  8. nearest nested AGENTS.md, if any
EOF
    ;;
  plan)
    slug="${2:-}"
    title="${3:-$slug}"
    if ! valid_slug "$slug"; then
      printf 'plan slug must use lowercase letters, numbers, and hyphens.\n' >&2
      exit 2
    fi
    target="$ROOT_DIR/docs/plans/active/$slug.md"
    if [[ -e "$target" ]]; then
      printf 'plan already exists: %s\n' "$target" >&2
      exit 1
    fi
    render_template "$ROOT_DIR/docs/templates/plan.md" "$target" "$slug" "$title"
    printf 'created %s\n' "$target"
    ;;
  experiment)
    slug="${2:-}"
    title="${3:-$slug}"
    if ! valid_slug "$slug"; then
      printf 'experiment slug must use lowercase letters, numbers, and hyphens.\n' >&2
      exit 2
    fi
    target="$ROOT_DIR/docs/experiments/runs/$slug.md"
    if [[ -e "$target" ]]; then
      printf 'experiment already exists: %s\n' "$target" >&2
      exit 1
    fi
    render_template "$ROOT_DIR/docs/templates/experiment.md" "$target" "$slug" "$title"
    printf 'created %s\n' "$target"
    ;;
  compact)
    slug="${2:-}"
    title="${3:-$slug}"
    if ! valid_slug "$slug"; then
      printf 'compaction slug must use lowercase letters, numbers, and hyphens.\n' >&2
      exit 2
    fi
    compact_snapshot "$slug" "$title"
    ;;
  research)
    slug="${2:-}"
    title="${3:-$slug}"
    if ! valid_slug "$slug"; then
      printf 'research slug must use lowercase letters, numbers, and hyphens.\n' >&2
      exit 2
    fi
    target="$ROOT_DIR/docs/research/$(date +%F)-$slug.md"
    [[ ! -e "$target" ]] || { printf 'research report already exists: %s\n' "$target" >&2; exit 1; }
    render_template "$ROOT_DIR/docs/templates/research.md" "$target" "$slug" "$title"
    printf 'created %s\n' "$target"
    ;;
  upgrade)
    slug="${2:-}"
    title="${3:-$slug}"
    if ! valid_slug "$slug"; then
      printf 'upgrade slug must use lowercase letters, numbers, and hyphens.\n' >&2
      exit 2
    fi
    target="$ROOT_DIR/docs/upgrades/proposals/$slug.md"
    [[ ! -e "$target" ]] || { printf 'upgrade proposal already exists: %s\n' "$target" >&2; exit 1; }
    render_template "$ROOT_DIR/docs/templates/upgrade.md" "$target" "$slug" "$title"
    printf 'created %s\n' "$target"
    ;;
  specialist)
    slug="${2:-}"
    title="${3:-$slug}"
    if ! valid_slug "$slug"; then
      printf 'specialist slug must use lowercase letters, numbers, and hyphens.\n' >&2
      exit 2
    fi
    target="$ROOT_DIR/agents/specialists/$slug.md"
    [[ ! -e "$target" ]] || { printf 'specialist already exists: %s\n' "$target" >&2; exit 1; }
    render_template "$ROOT_DIR/docs/templates/specialist.md" "$target" "$slug" "$title"
    printf 'created %s\n' "$target"
    ;;
  suggest-upgrades)
    suggest_upgrades "$@"
    ;;
  friction)
    shift
    friction_command "$@"
    ;;
  learn)
    shift
    learn_command "$@"
    ;;
  retro)
    shift
    retro_command "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
