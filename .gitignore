# Local credentials and environment files
.env
.env.*
!.env.example
*.pem
*.key
backend/.venv/
backend/.pytest_cache/
backend/.coverage*

# Terraform local state and provider data
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfstate.backup
backend/infra/bootstrap/*.tfvars
backend/infra/terraform/*.tfvars

# Agent-local state and editor noise
.agent-state/
.pytest_cache/
__pycache__/
*.py[cod]
.codex/*
!.codex/hooks.json
.claude/settings.local.json
.cursor/*.local.json
.cursor/mcp.json
.DS_Store
.idea/
.vscode/*.local.json

# JS tests and generated builds
/node_modules/
/frontend/node_modules/
/frontend/dist/
build/
coverage/
playwright-report/
test-results/
*.log

# Impeccable downloads its platform engine on first use; keep binaries local.
.agents/skills/impeccable/scripts/bin/
.claude/skills/impeccable/scripts/bin/
.cursor/skills/impeccable/scripts/bin/
.impeccable/*.local.json
.impeccable/hook.cache.json

# Existing static-site/template exclusions
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
/vendor
Gemfile.lock
frontend/assets/js/chatbot.config.js
chatbot.md

# Local project resources; tracked app code lives outside this directory.
/resources/
